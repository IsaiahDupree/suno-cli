# Suno CLI Environment Variables
# Copy this file to .env.local and fill in your values

# Browser & Session
# Suno workspace login is handled via browser UI
# Session is persistent in ./browser-data/

# Download Settings
SUNO_FORMAT=wav              # wav or mp3 (default: wav)
SUNO_DOWNLOAD_LIMIT=         # Max tracks to download (default: all)
SUNO_RESUME=true             # Resume downloads, skip already downloaded (default: true)

# Generation Settings
SUNO_MODEL=v5                # Model version: v3.5, v4, v5, v5.5 (default: v5)
SUNO_VOICE=                  # Default voice for generation (optional)
SUNO_STYLE=                  # Default style/genre for generation (optional)

# Logging & Debugging
SUNO_DEBUG=false             # Enable debug logging (default: false)
SUNO_LOG_FILE=              # Write logs to file (optional)
SUNO_LOG_LEVEL=info          # Log level: debug, info, warn, error (default: info)

# File Management
SUNO_DOWNLOADS_DIR=./downloads  # Directory for downloaded files (default: ./downloads)
SUNO_SAVE_METADATA=true         # Save metadata JSON with each download (default: true)

# Persistent Config
# Configuration is stored in ~/.suno/config.json
# View/update with: node suno-cli.js config [--get key] [--set key value] [--reset]

# Development
NODE_ENV=production          # Node environment: development, production (default: production)
